<Window x:Class="KofOnlineLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KOF Online" Width="1100" Height="680" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#FF08090D">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>

    <Image Grid.RowSpan="3" Source="/Assets/kyo-orochi-andrew-background.png" Stretch="UniformToFill" Opacity="0.96" />
    <Rectangle Grid.RowSpan="3">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
          <GradientStop Color="#D8050609" Offset="0" />
          <GradientStop Color="#5E0A0B10" Offset="0.42" />
          <GradientStop Color="#4811080A" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Border Grid.Row="0" Background="#DC090A0F" BorderBrush="#44F2BA49" BorderThickness="0,0,0,1">
      <Grid Margin="28,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="KOF" Foreground="{StaticResource Gold}" FontSize="27" FontWeight="Black" />
          <TextBlock Text=" ONLINE" Foreground="White" FontSize="27" FontWeight="Light" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Ellipse x:Name="ServerDot" Width="9" Height="9" Fill="#FF777777" Margin="0,0,8,0" />
          <TextBlock x:Name="ServerStatus" Text="Servidor ainda não iniciado" Foreground="#FFB8B8BE" FontSize="13" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="55,35">
      <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Width="360" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="KING OF FIGHTERS" Foreground="#FFB9BAC2" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="98 CUSTOM" Foreground="White" FontSize="47" FontWeight="Black" Margin="0,-2,0,4" />
        <Rectangle Height="3" Fill="{StaticResource Gold}" Width="95" HorizontalAlignment="Left" Margin="0,0,0,25" />
        <Button x:Name="GameButton" Content="JOGAR" Click="PlayGame_Click" ToolTip="Abrir KOF Andrew Online" />
        <Button Content="CONFIGURAÇÕES" Click="Settings_Click" Background="#FF242631" BorderBrush="#FF555865" />
      </StackPanel>

      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="9" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="30" Margin="28,28,0,28">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="KOF ANDREW ONLINE" Foreground="{StaticResource Gold}" FontSize="18" FontWeight="Bold" />
          <Grid Grid.Row="1" Margin="8,16,8,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="205"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,25,0">
              <TextBlock Text="UM PROJETO FEITO" Foreground="White" FontSize="27" FontWeight="Black" TextAlignment="Center" />
              <TextBlock Text="PARA DIVERSÃO" Foreground="{StaticResource Gold}" FontSize="31" FontWeight="Black" TextAlignment="Center" Margin="0,2,0,0" />
              <Rectangle Height="3" Width="90" Fill="#FFB32631" Margin="0,15,0,15" />
              <TextBlock Text="O modo ONLINE agora fica dentro do jogo e aparece somente quando o servidor está disponível." Foreground="#FFC3C4CC" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="310" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="AJUDE MEU PROJETO" Foreground="{StaticResource Gold}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
              <Border Background="White" CornerRadius="11" Padding="8" BorderBrush="#66F2BA49" BorderThickness="1">
                <Image Source="/Assets/ajude-projeto-qrcode.png" Width="165" Height="168" Stretch="Uniform" />
              </Border>
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" Background="#66101016" CornerRadius="5" Padding="15,12">
            <StackPanel>
              <TextBlock Text="INSTALAÇÃO E ATUALIZAÇÕES" Foreground="#FF888B95" FontSize="11" FontWeight="Bold" />
              <TextBlock x:Name="GameStatus" Text="Verificando…" Foreground="White" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
              <ProgressBar x:Name="UpdateProgress" Height="5" Margin="0,9,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#CC07080C" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
      <Grid Margin="28,0">
        <TextBlock Text="KOFF COMMUNITY SERVER" Foreground="#FF777983" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" />
        <TextBlock Text="Made By Andrew" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
        <TextBlock x:Name="VersionText" Text="verificando versão…" Foreground="#FF777983" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" />
      </Grid>
    </Border>
  </Grid>
</Window>
